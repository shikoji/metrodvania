[sub_resource type="Shader" id="Shader_wveb5"]
code = "shader_type canvas_item;

uniform float progress : hint_range(0.0, 1.0) = 0.0;
uniform float diamonds : hint_range(4.0, 40.0) = 12.0;
uniform float softness : hint_range(0.001, 0.2) = 0.03;
uniform vec4 fade_color : source_color = vec4(0.0, 0.0, 0.0, 1.0);

void fragment() {
	vec2 uv = UV;

	// Diamond grid
	vec2 grid_uv = uv * diamonds;
	vec2 cell = fract(grid_uv) - 0.5;

	// Diamond shape
	float diamond = abs(cell.x) + abs(cell.y);

	// Sweep from top-left to bottom-right
	float sweep = (uv.x + uv.y) * 0.5;

	// Progress threshold
	float threshold = progress - sweep * 0.35;

	// Softer reveal
	float mask = 1.0 - smoothstep(threshold - softness, threshold + softness, diamond);

	COLOR = vec4(fade_color.rgb, mask * fade_color.a);
}"

